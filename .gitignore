# ============================================================================
# .gitignore —— 笔记库发布用排除规则
# 完整说明见 23_GitHub发布规范.md 第三节
# ============================================================================

# ---- 编译产物 ----
*.exe
*.o
*.a
*.out
*.obj
*.pdb
*.ilk
*.dSYM/

# ---- Visual Studio 工程中间文件 ----
*.vcxproj.user
*.vs/
.vs/
Debug/
Release/
x64/

# ---- 临时测试与基准数据 ----
# 性能实测产生的输入输出文件体积可达数十 MB，不入库
50_工具与模板/54_性能实测源码/*.txt
50_工具与模板/54_性能实测源码/*.exe
*.in
in.txt
out.txt

# ---- 打包快照 ----
# 整库压缩包是**发布时生成的快照**，不是源文件。
# 每次发布都生成一份新包会让仓库体积随版本线性增长（单份 67 MB），
# 且内容与仓库自身重复。改为：本地保留，不入库；历史版本用 git tag 回溯。
学习工程_*.zip

# ---- 本地备份与临时目录 ----
50_工具与模板/.backup/
.backup/
*.bak

# ---- 凭据与密钥（与发布规范的硬规则一重复，作为双保险） ----
*.key
*.pem
id_rsa*
.env
*account*.json
凭据*
key*.txt

# ---- 系统与编辑器 ----
Thumbs.db
desktop.ini
.DS_Store
.obsidian/workspace*
.obsidian/cache

# ---- Python ----
__pycache__/
*.pyc
